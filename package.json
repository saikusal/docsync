{
  "name": "docsync",
  "version": "0.1.0",
  "description": "Keeps a repository's README in sync with its code: env vars, API routes, setup, tech stack and more.",
  "license": "MIT",
  "author": "saikusal",
  "repository": {
    "type": "git",
    "url": "https://github.com/saikusal/docsync.git"
  },
  "type": "module",
  "bin": {
    "docsync": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docsync": "node dist/cli.js"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "ignore": "^7.0.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
